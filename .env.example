# Chép thành .env rồi đổi giá trị (Windows PowerShell: Copy-Item .env.example .env).
# .env chứa bí mật nên KHÔNG commit (đã có trong .gitignore). Tệp mẫu này chỉ có giá trị minh hoạ.

# ---------- Cơ sở dữ liệu ----------
# Chạy bằng Docker: container db tự tạo CSDL và tài khoản theo ba giá trị dưới, không cần cài PostgreSQL.
# Chạy trực tiếp bằng Node: điền tài khoản PostgreSQL trên máy bạn.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=smartcrm
DB_USER=smartcrm_app
DB_PASSWORD=doi_mat_khau_nay
# Chỉ dùng cho Docker: cổng mở CSDL trong container ra máy (5433 để không đụng PostgreSQL cài sẵn ở 5432)
DB_PUBLISH_PORT=5433
# Thời gian chờ kết nối CSDL (mili giây); quá thời gian thì API trả 503 thay vì treo
DB_CONNECT_TIMEOUT_MS=5000

# ---------- API ----------
APP_PORT=3000
# Khoá ký token: chuỗi ngẫu nhiên, ít nhất 32 ký tự. Tạo bằng:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SECRET_KEY=doi-chuoi-nay-thanh-chuoi-ngau-nhien-it-nhat-32-ky-tu
# Nguồn giao diện được gọi API khi chạy bằng Node (Vite); nhiều nguồn cách nhau bằng dấu phẩy.
# Chạy bằng Docker không cần: giao diện gọi /api cùng nguồn qua nginx.
CORS_ORIGIN=http://localhost:5173,http://localhost:5174
# Mật khẩu của các tài khoản mẫu ktv1..ktv6, quanly1..quanly6 do seed tạo
DEMO_PASSWORD=matkhau-demo-2026
# debug | info | warn | error
LOG_LEVEL=info

# ---------- Dữ liệu seed ----------
# Docker: thư mục CSV gắn vào container. ./data-mau là dữ liệu mẫu nhỏ có sẵn trong repo;
# đổi thành ./data nếu đã chép dataset đầy đủ vào data/ (rồi docker compose down -v và up lại).
LOCAL_DATA_DIR=./data-mau
# Node: npm run seed đọc thư mục DATA_DIR (tính từ gốc repo), bỏ trống là data/
DATA_DIR=

# ---------- Giao diện (Docker) ----------
# Mở http://localhost:8080
WEB_PORT=8080

# ---------- Test ----------
# CSDL riêng cho npm test, tên phải kết thúc bằng _test
TEST_DB_NAME=smartcrm_test
